# Provider attivo: "openrouter" oppure "ollama"
LLM_PROVIDER=openrouter

# Configurazione OpenRouter (usata quando LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Configurazione Ollama locale (usata quando LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b-a3b-coding-nvfp4

# Porte dei server (Backend Express e Frontend Vite)
PORT=3002
FRONTEND_PORT=5173

# Logging delle richieste e chiamate JSON ai modelli LLM (true / false)
LLM_LOG_ENABLED=true
LLM_LOG_FILE=llm-calls.log

# Passphrase di accesso all'applicazione (lascia vuoto per disabilitare il controllo)
APP_PASSPHRASE=promptbuilder
